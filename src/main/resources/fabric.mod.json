{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "license": "${mod_license}",
    "icon": "${mod_logo_file}",
    "authors": ["mod_authors"],
    "contact": {
        "homepage": "${mod_display_url}",
        "issues": "${mod_issue_tracker_url}",
        "sources": "${mod_sources_url}"
    },
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.p3pp3rf1y.sophisticatedcore.SophisticatedCore"
        ],
        "client": [
            "net.p3pp3rf1y.sophisticatedcore.client.ClientEventHandler"
        ],
        "fabric-datagen": [
            "net.p3pp3rf1y.sophisticatedcore.data.DataGenerators"
        ],
        "jei_mod_plugin": [
            "net.p3pp3rf1y.sophisticatedcore.compat.jei.CorePlugin"
        ]
    },
    "mixins": [
        "sophisticatedcore.mixins.json"
    ],
    "accessWidener": "sophisticatedcore.accesswidener",
    "depends": {
        "minecraft": "~${minecraft_version}",
        "java": ">=25",
        "fabricloader": ">=${loader_version}",
        "fabric-api": ">=${fabric_version}",
        "forgeconfigapiport": ">=${forge_config_version}",
        "team_reborn_energy": ">=${energy_version}"
    },
    "suggests": {
        "modmenu": "*"
    },
    "breaks": {
        "jei": "<${jei_version}"
    },
    "custom": {
        "loom:injected_interfaces": {
            "net/minecraft/client/gui/screens/inventory/AbstractContainerScreen": ["net/p3pp3rf1y/sophisticatedcore/extensions/client/gui/screens/inventory/SophisticatedAbstractContainerScreen"],
            "net/minecraft/world/entity/Entity": ["net/p3pp3rf1y/sophisticatedcore/extensions/entity/SophisticatedEntity"],
            "net/minecraft/world/entity/player/Player": ["net/p3pp3rf1y/sophisticatedcore/extensions/entity/SophisticatedPlayer"],
            "net/minecraft/world/inventory/Slot": ["net/p3pp3rf1y/sophisticatedcore/extensions/inventory/SophisticatedSlot"],
            "net/minecraft/world/item/Item": ["net/p3pp3rf1y/sophisticatedcore/extensions/item/SophisticatedItem"],
            "net/minecraft/world/item/ItemStack": ["net/p3pp3rf1y/sophisticatedcore/extensions/item/SophisticatedItemStack", "net/p3pp3rf1y/sophisticatedcore/extensions/component/SophisticatedMutableDataComponentHolder"],
            "net/minecraft/world/level/Level": ["net/p3pp3rf1y/sophisticatedcore/extensions/world/SophisticatedLevel"],
            "net/minecraft/world/level/block/Block": ["net/p3pp3rf1y/sophisticatedcore/extensions/block/SophisticatedBlock"],
            "net/minecraft/world/level/block/state/BlockState": ["net/p3pp3rf1y/sophisticatedcore/extensions/block/SophisticatedBlockState"],
            "net/minecraft/world/level/block/entity/BlockEntity": ["net/p3pp3rf1y/sophisticatedcore/extensions/block/entity/SophisticatedBlockEntity"],
            "net/minecraft/core/component/DataComponentHolder": ["net/p3pp3rf1y/sophisticatedcore/extensions/component/SophisticatedDataComponentHolder"],
            "net/minecraft/world/item/component/ItemContainerContents": ["net/p3pp3rf1y/sophisticatedcore/extensions/item/component/SophisticatedItemContainerContents"]
        },
        "modmenu": {
            "badges": ["library"],
            "parent": {
                "id": "sophisticatedmods",
                "name": "Sophisticated Mods",
                "description": "Group of P3pp3rf1y's Sophisticated Mods"
            }
        }
    }
}
